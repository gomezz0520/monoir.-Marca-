---
// Una prenda colgada de su gancho (para el perchero).
// Usa la misma ilustración de la prenda y le agrega el gancho:
// de madera para camisetas y buzos, de pinzas para pantalones e interior.
// Coordenadas del dibujo completo: 400 x 560. El riel pasa a la altura y = 20.
// Con fotos reales (campo `fotos` del producto) se usa la foto: debe ser vertical 400x560
// (proporción 5:7), fondo transparente y el gancho tocando el borde de arriba.
import Prenda from './Prenda.astro';
import type { Producto } from '../data/productos';

interface Props { p: Producto; lado: 'frente' | 'espalda'; class?: string }
const { p, lado, class: clase = '' } = Astro.props;

const capota = p.slug.includes('capota');
const deTorso = p.tipo === 'camiseta' || p.tipo === 'buzo';
// Cuánto bajar el dibujo para que los hombros (o la pretina) queden en el gancho.
const bajar: Record<string, number> = { camiseta: 38, buzo: 22, jogger: 60, jean: 42, boxer: -46, medias: 44 };
const dy = bajar[p.tipo] ?? 40;

// Gancho de madera (en coordenadas de la prenda): se esconde detrás del frente.
const barra = p.tipo === 'camiseta' ? 'M78 108 Q200 46 322 108' : 'M76 124 Q200 60 324 124';
const centroBarra = p.tipo === 'camiseta' ? 70 : 85; // borde de arriba de la barra en el centro
// Pinzas: dónde muerden la pretina.
const pinzas = p.tipo === 'medias' ? [151, 241] : [126, 274];
// Donde empieza el gancho metálico (en coordenadas del dibujo completo).
const baseGancho = deTorso ? centroBarra + dy + 2 : 70;
const gancho = `M200 ${baseGancho} L200 36 C200 24 206 14 216 14 C226 14 232 22 230 31 C229 36 225 39 221 39`;
---
{p.fotos ? (
  <img class={`colgada-foto ${clase}`} src={lado === 'frente' ? p.fotos.frente : p.fotos.espalda} alt="" loading="lazy" decoding="async"
    style="width:100%;height:100%;object-fit:contain;object-position:50% 0" />
) : (
<svg class={`colgada-svg ${clase}`} viewBox="0 0 400 560" aria-hidden="true" overflow="visible">
  <Prenda tipo={p.tipo} color={p.color.hex} lado={lado} capota={capota} estampado={p.estampadoEspalda}
    x={0} y={dy} ancho={400} alto={500} interior>
    {deTorso && (
      <g slot="gancho">
        <path d={barra} fill="none" stroke="url(#madera)" stroke-width="13" stroke-linecap="round" />
        <path d={barra} fill="none" stroke="rgba(255,255,255,.18)" stroke-width="2" stroke-linecap="round" transform="translate(0 -4)" />
      </g>
    )}
  </Prenda>
  {!deTorso && (
    <g>
      <rect x="92" y="64" width="216" height="12" rx="6" fill="url(#madera)" />
      {pinzas.map((x) => (
        <g>
          <rect x={x - 9} y="70" width="18" height="44" rx="3" fill="#2a2a2c" />
          <rect x={x - 9} y="70" width="18" height="10" rx="3" fill="#9c9ca0" />
          <rect x={x - 5} y="84" width="10" height="2" fill="#555" />
        </g>
      ))}
    </g>
  )}
  <path d={gancho} fill="none" stroke="url(#metal)" stroke-width="4.5" stroke-linecap="round" />
</svg>
)}
